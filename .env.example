# Web + API server
PORT=3000
NODE_ENV=development

# SQLite database file (relative to the project root or absolute path)
DATABASE_PATH=backend/data/catv.sqlite
PRIVATE_STORAGE_PATH=backend/data

# Object storage: local for development/tests, r2 for production.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=catv-storage
R2_ENDPOINT=
R2_SIGNED_URL_TTL_SECONDS=300

# Immutable straight-map pipeline. Local development supports streamed disk upload.
# In production, enable only after DB/R2 backup and three-map pilot validation.
STRAIGHT_MAP_PIPELINE_V2_ENABLED=true
STRAIGHT_MAP_RENDERER_DEVICE_TOKEN=
STRAIGHT_MAP_TARGET_DPI=1200
STRAIGHT_MAP_TILE_SIZE=256
STRAIGHT_MAP_WEBP_QUALITY=94
STRAIGHT_MAP_LEASE_SECONDS=600

# Replace with a long random value in production (at least 32 bytes)
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=catv_session
# strict/lax for same-site proxy deployments; none requires HTTPS for a cross-site API.
SESSION_COOKIE_SAME_SITE=strict

# Comma-separated exact frontend origins. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Restrict destructive/admin writes to production UI origins (exclude preview URLs).
ADMIN_MUTATION_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENFORCE_HTTPS=false
JSON_BODY_LIMIT=30mb

# Persistent IP + account login lockout.
LOGIN_FAILURE_LIMIT=5
LOGIN_WINDOW_MINUTES=10

# Used only once when the production database has no users. Remove after bootstrap.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Frontend API base. Same-origin /api is recommended.
VITE_API_URL=/api
# Cloudflare Pages can use the explicit Render API URL instead.
VITE_API_BASE_URL=

# Legacy storage URL. New field photos and floor plans are served through authenticated API routes.
STORAGE_URL=/uploads

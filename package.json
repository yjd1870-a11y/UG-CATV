{
  "name": "catv-work-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5 <25"
  },
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "tsx backend/server.ts --api-only",
    "build": "vite build",
    "start": "tsx backend/server.ts",
    "db:init": "tsx backend/init-db.ts",
    "test:api": "tsx backend/tests/run-isolated.ts backend/tests/api.integration.ts",
    "test:security": "tsx backend/tests/run-isolated.ts backend/tests/security.integration.ts",
    "test:database-restart": "tsx backend/tests/run-isolated.ts backend/tests/database-restart.ts",
    "test:b2c-linebook": "tsx backend/tests/run-isolated.ts backend/tests/b2c-linebook.ts",
    "test:straight-map": "tsx backend/tests/run-isolated.ts backend/tests/straight-map-ooxml.ts",
    "test:straight-map-portable": "tsx backend/tests/run-isolated.ts backend/tests/straight-map-portable-render.ts",
    "test:straight-map-lifecycle": "tsx backend/tests/run-isolated.ts backend/tests/straight-map-lifecycle.ts",
    "test:straight-map-reupload": "tsx backend/tests/run-isolated.ts backend/tests/straight-map-reupload.ts",
    "test:straight-map-single-page": "tsx backend/tests/run-isolated.ts backend/tests/straight-map-single-page.ts",
    "straight-map:retry": "tsx scripts/retry-straight-map-renders.ts",
    "straight-map:reindex": "tsx scripts/reindex-straight-map-coordinates.ts",
    "import:data": "tsx scripts/import-data.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@e965/xlsx": "^0.20.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "openseadragon": "^6.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/openseadragon": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
